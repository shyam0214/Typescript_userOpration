{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "inlineSourceMap": true,
        "lib": [
            "es6",
            "dom",
            "esnext"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        "noLib": false,
        "outDir": "./dist",
        "rootDir": "./src",
        "skipLibCheck": true,
        "baseUrl": "./",
        "paths": {
            "@root/*": [
                "./*"
            ],
            "*": [
                "node_modules/*"
            ]
        },
        "removeComments": true,
        "resolveJsonModule": true,
        "target": "es6"
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src/**/*.ts",
        "src/ssl/*.key"
    ]
}